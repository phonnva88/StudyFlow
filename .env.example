# LiveKit Cloud project (server only; URL is returned to authorized clients)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Upstash Redis database, REST credentials (server only)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Optional: official provider search (server only; never NEXT_PUBLIC_)
# Enable YouTube Data API v3 in the key's Google Cloud project.
YOUTUBE_API_KEY=
# Spotify application credentials; no listener login needed for search.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
